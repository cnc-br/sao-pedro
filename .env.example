# ==============================================================================
# São Pedro — Serviço Central de Identidade e Pessoas (CNC-Gestão)
# NUNCA insira credenciais reais neste arquivo. Copie para .env e ajuste localmente.
# ==============================================================================

# Chave secreta do Django (Gere uma chave local para desenvolvimento)
SECRET_KEY="django-insecure-[REDACTED_DEV_SECRET_KEY]"

# Modo Debug (True em desenvolvimento local, False em produção)
DEBUG=True

# Conexão com o PostgreSQL 17 (Banco unificado db_gestao, schema saopedro)
# Formato: postgres://usuario:senha@host:porta/banco?options=-csearch_path%3Dschema,public
DATABASE_URL="postgres://saopedro:[REDACTED]@localhost:5432/db_gestao?options=-csearch_path%3Dsaopedro,public"

# Hosts autorizados (separados por vírgula)
ALLOWED_HOSTS="localhost,127.0.0.1,cncbrasil2-direct.cn.org.br,cncbrasil2.cn.org.br"

# Origens autorizadas para CORS e CSRF
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://cncbrasil2.cn.org.br"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,https://cncbrasil2.cn.org.br"
